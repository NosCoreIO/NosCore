// The rooms, the start point, the boss portal, the levers and the monsters follow a packet trace of
// the raid. Seven of the field's nineteen levers count; with them pulled and eight monsters down, the
// way to the farm opens.
public class GinsengRaid : InstanceScript
{
    private const short Ginseng = 284;
    private const short LeverOff = 1135;
    private const short LeverOn = 1136;
    private const short MonsterGoal = 8;
    private const int CountingLevers = 7;

    private static readonly Spot[] Levers =
    [
        new(113, 145), new(24, 158), new(83, 113), new(109, 80), new(126, 14), new(142, 168), new(177, 103),
        new(88, 115), new(61, 49), new(121, 129), new(121, 155), new(155, 115), new(53, 112), new(62, 112),
        new(80, 112), new(81, 116), new(83, 173), new(84, 110), new(85, 118)
    ];

    private readonly int _field;
    private readonly int _farm;

    public GinsengRaid()
    {
        Definition = InstanceDefinitionBuilder.Named(1, "raid-ginseng", "raid-ginseng")
            .ForLevels(40, 59)
            .ForTeams(5, 15)
            .Requiring(1128, 1)
            .StartingAt(23, 179)
            .WithRoom(2521, out _field, 0, 1)
            .WithRoom(2522, out _farm, 0, 0)
            .WithReward(4685, 1)
            .Build();
    }

    public override void OnFirstEnter(IInstanceRun run)
    {
        run.StartClock(TimeSpan.FromHours(2));
        run.SpawnPortal(_field, new Spot(31, 13), _farm, new Spot(31, 57));
        run.SetMonsterLocker(_field, MonsterGoal);
        for (var i = 0; i < Levers.Length; i++)
        {
            run.PlaceButton(_field, i + 1, Levers[i], LeverOff, LeverOn);
        }

        run.Summon(_field, Pack(22, (96, 174), (88, 174), (78, 173), (71, 173), (61, 173), (57, 173), (109, 174), (102, 174), (59, 56), (59, 67), (59, 59), (59, 55), (59, 61), (59, 54), (59, 60)));
        run.Summon(_field, Pack(23, (181, 63), (181, 62), (181, 61), (181, 60), (181, 59), (181, 58), (181, 57), (181, 56), (181, 55), (181, 54), (179, 60), (179, 59), (179, 58), (179, 57), (179, 56), (179, 55), (179, 54), (178, 95), (178, 87), (178, 85), (178, 80), (178, 77), (178, 73), (178, 69), (178, 64), (178, 61), (178, 134), (178, 132), (178, 127), (178, 125), (178, 119), (178, 116), (178, 112), (150, 64), (178, 104), (178, 100), (176, 102)));
        run.Summon(_field, Pack(61, (64, 140), (63, 141), (62, 141), (60, 141), (58, 141), (57, 141), (55, 141), (53, 141), (52, 141)));
        run.Summon(_field, Pack(62, (126, 119), (124, 119), (122, 149), (122, 119), (119, 119), (117, 119)));
        run.Summon(_field, Pack(68, (127, 153), (126, 157), (125, 140), (123, 161), (121, 165), (118, 156), (117, 171), (117, 161), (117, 145), (116, 152), (115, 141)));
        run.Summon(_field, Pack(75, (27, 124), (25, 125), (24, 125), (23, 125), (21, 124)));
        run.Summon(_field, Pack(77, (60, 94), (60, 100), (59, 97), (58, 94), (55, 99), (55, 96), (29, 99), (28, 96), (26, 98), (26, 93), (25, 95), (89, 66), (141, 65), (146, 64), (104, 64), (101, 64), (87, 64), (85, 63), (95, 63), (148, 65), (140, 64), (97, 63), (137, 66), (151, 63), (114, 67), (128, 67), (142, 67), (127, 67), (85, 65), (126, 67), (124, 63)));
        run.Summon(_field, Pack(90, (27, 126), (27, 125), (25, 124), (23, 124), (21, 126), (21, 125)));
        run.Summon(_field, Pack(91, (113, 108), (121, 107), (114, 108), (117, 109), (115, 108), (113, 107), (119, 108), (113, 109), (119, 110)));
        run.Summon(_field, Pack(132, (91, 144), (88, 140), (84, 140), (82, 143), (76, 139), (73, 140), (68, 141), (63, 134), (67, 139), (68, 144), (63, 141), (65, 142), (64, 137), (67, 136), (65, 143), (64, 139), (73, 143), (63, 137), (73, 139), (63, 139), (65, 138), (70, 144), (73, 137), (64, 135), (67, 140), (69, 141), (66, 140), (71, 141), (65, 144), (64, 140), (66, 138), (69, 140), (66, 142), (72, 139), (64, 143), (68, 143), (69, 145), (25, 128), (24, 123), (22, 126), (27, 128), (25, 135), (21, 123), (24, 130), (24, 124), (27, 140), (28, 128), (27, 144), (25, 112), (27, 134), (28, 125), (21, 117), (24, 119), (22, 102), (20, 112), (24, 105), (24, 147), (25, 116), (26, 149), (24, 141), (20, 140)));
        run.Summon(_field, Pack(133, (126, 118), (123, 109), (118, 117), (119, 110), (115, 109), (121, 121), (118, 108), (128, 109), (127, 121), (126, 108), (25, 15), (118, 110), (116, 119), (116, 108), (127, 111), (113, 116), (122, 108), (113, 109), (114, 118), (125, 118)));
        run.Summon(_field, Pack(134, (90, 64), (25, 127), (23, 127), (148, 65), (135, 64), (118, 64), (105, 65), (160, 134), (152, 133), (151, 135), (150, 132)));
        run.Summon(_field, Pack(135, (96, 29), (88, 25), (163, 18), (162, 15), (158, 15), (157, 17), (155, 16), (108, 26)));
        run.Summon(_field, Pack(138, (63, 143), (63, 142), (62, 143), (61, 142), (60, 143), (59, 143), (59, 142), (57, 143), (57, 142), (55, 143), (55, 142), (53, 143)));
        run.Summon(_field, Pack(139, (45, 48), (45, 47), (45, 46), (45, 45)));
        run.Summon(_field, Pack(144, (54, 160), (54, 159), (54, 158), (54, 157), (53, 160), (53, 159), (53, 158), (53, 157), (52, 160), (52, 159), (52, 158), (52, 157)));
        run.Summon(_field, Pack(154, (152, 176), (152, 175), (152, 174), (152, 173), (152, 172), (152, 171), (152, 170), (152, 169), (152, 168), (152, 167), (148, 180), (149, 181), (151, 180)));
        run.Summon(_field, Pack(161, (94, 182), (94, 181), (94, 180), (87, 182), (87, 181), (87, 180), (86, 182), (86, 181), (86, 180), (85, 182), (85, 181), (85, 180), (83, 182), (83, 181), (83, 180), (80, 182), (80, 181), (80, 180), (75, 182), (75, 181), (75, 180), (70, 182), (70, 181), (70, 180), (60, 182), (60, 181), (60, 180), (59, 74), (59, 182), (59, 181), (59, 180), (37, 33), (35, 30), (33, 36), (32, 31), (31, 28), (29, 36), (27, 31), (24, 113), (160, 38), (150, 132), (149, 178), (132, 104), (131, 107), (131, 102), (130, 101), (126, 93), (124, 89), (122, 95), (122, 123), (120, 87), (119, 94), (118, 91), (114, 84), (111, 87), (110, 182), (110, 181), (110, 180), (106, 86), (103, 83), (101, 182), (101, 181), (101, 180), (22, 111), (25, 110), (23, 116), (27, 108)));
        run.Summon(_field, Pack(162, (130, 36), (128, 37), (125, 37), (123, 37), (122, 123), (129, 130), (123, 128), (126, 127), (126, 124)));
        run.Summon(_field, Pack(212, (149, 180), (146, 180), (145, 175), (144, 177), (143, 173)));
        run.Summon(_field, Pack(226, (157, 106), (156, 107), (156, 103), (154, 109), (154, 105)));
        run.Summon(_field, Pack(290, (42, 38), (33, 31), (37, 41), (41, 31), (32, 40), (37, 35), (35, 32), (33, 32), (42, 40), (35, 40), (42, 32), (37, 34), (38, 34), (40, 41), (39, 33), (35, 41), (35, 31), (36, 35), (35, 38), (39, 37), (42, 31), (40, 32), (34, 38), (34, 37), (41, 33), (41, 39)));
        run.Summon(_field, Pack(291, (50, 96)));
        run.Summon(_field, Pack(950, (90, 141), (78, 141), (177, 86), (177, 70), (177, 133), (177, 110), (129, 103), (126, 33), (120, 89), (108, 86)));
        run.Summon(_field, Pack(951, (177, 93), (177, 78), (177, 125), (177, 117)));
        run.Summon(_farm, new MonsterSpawn(Ginseng, new Spot(31, 37)));
        run.Summon(_farm, Pack(161, (16, 37), (22, 20), (23, 42), (25, 33), (26, 26), (29, 34), (30, 44), (31, 26), (33, 19), (34, 31), (37, 41), (38, 22), (45, 35)));
        run.Summon(_farm, Pack(290, (14, 30), (14, 34), (15, 27), (16, 41), (19, 22), (19, 45), (23, 46), (25, 19), (27, 16), (28, 47), (31, 18), (34, 47), (36, 18), (39, 20), (39, 46), (42, 23), (43, 26), (43, 32), (44, 36)));
        run.Summon(_farm, Pack(291, (44, 21), (41, 18), (37, 16), (32, 15), (27, 15), (21, 17), (16, 20)));
    }

    public override void OnRoomCleared(IInstanceRun run, int room) => OpenFarmWhenReady(run);

    public override void OnButtonUsed(IInstanceRun run, int room, int button) => OpenFarmWhenReady(run);

    public override void OnMonsterKilled(IInstanceRun run, int room, short vNum)
    {
        if (vNum == Ginseng)
        {
            run.Succeed();
        }
    }

    public override void OnTimeout(IInstanceRun run) => run.Fail();

    private void OpenFarmWhenReady(IInstanceRun run)
    {
        if (run.LockerLeft(_field) > 0)
        {
            return;
        }

        for (var button = 1; button <= CountingLevers; button++)
        {
            if (!run.IsButtonOn(_field, button))
            {
                return;
            }
        }

        run.UnlockPortal(_field, _farm);
    }

    private static MonsterSpawn[] Pack(short vNum, params (short X, short Y)[] spots) =>
        Array.ConvertAll(spots, s => new MonsterSpawn(vNum, new Spot(s.X, s.Y)));
}

return new GinsengRaid();
