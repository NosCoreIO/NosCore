# Copy to .env and replace every value. docker compose reads .env automatically; when running
# a server outside Docker, export the same variables in its environment.
# None of these may be left empty or set to a shipped default such as CHANGE_ME.

# PostgreSQL password for the postgres user, used by the database container and every server.
DB_PASSWORD=
# Shared by the master, world, login and web API servers.
MASTER_PASSWORD=
# Web API only: signs the launcher session tokens. At least 32 characters.
JWT_SIGNING_KEY=
# Web API only: key the client uses to sign NosMall requests.
MALL_SIGNATURE_KEY=
# Only when MESSAGING_TRANSPORT=RabbitMq: broker URI with its own credentials.
# RABBITMQ_URI=amqp://user:password@rabbitmq:5672
